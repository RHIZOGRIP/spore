{
  "name": "@rhizogrip/spore-plugin-browser",
  "version": "0.4.0",
  "description": "A browser for spores: each its own headless Chrome, run by a service and driven by agent-browser",
  "author": {
    "name": "Christophe Le Bars",
    "email": "clb@toort.net"
  },
  "type": "module",
  "bin": {
    "spore-browser": "bin/spore-browser.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RHIZOGRIP/spore.git",
    "directory": "plugins/browser"
  },
  "homepage": "https://rhizogrip.com/plugins",
  "engines": {
    "node": ">=24"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "files": [
    "bin/",
    "src/",
    "reference.md",
    "README.md",
    "NOTICE"
  ],
  "dependencies": {
    "agent-browser": "0.41.1",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@rhizogrip/spore": "^1.50.0"
  },
  "scripts": {
    "test": "vitest run"
  },
  "spore": {
    "works": "^1.50.0",
    "settings": {
      "chromium": "text"
    },
    "options": {
      "profile": {
        "values": [
          "ephemeral",
          "persistent"
        ],
        "default": "ephemeral"
      }
    },
    "programs": {
      "SPORE_BROWSER": "./bin/browse.js"
    },
    "describe": [
      {
        "program": "^\"?\\$SPORE_BROWSER\"?\\s*(.*)$",
        "title": "using the browser",
        "category": "fetch",
        "detail": "browser $1"
      }
    ],
    "env": {
      "AGENT_BROWSER_SESSION": "{name}",
      "AGENT_BROWSER_PIN_TAB": "1",
      "AGENT_BROWSER_SOCKET_DIR": "{sockets}/browser",
      "AGENT_BROWSER_SCREENSHOT_DIR": "{data}/browser",
      "AGENT_BROWSER_DOWNLOAD_PATH": "{data}/browser/downloads"
    },
    "reference": "reference.md",
    "services": {
      "browser": {
        "what": "each spore's own headless Chrome, behind an endpoint only that spore can reach",
        "program": "./bin/spore-browser.js",
        "check": [
          "--check"
        ]
      }
    }
  },
  "release-it": {
    "git": {
      "requireBranch": "main",
      "commitMessage": "release: plugin-browser v${version}",
      "tagName": "plugin-browser-v${version}",
      "requireUpstream": false,
      "push": true
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": false
    }
  },
  "license": "Apache-2.0"
}
