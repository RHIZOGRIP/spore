{
  "name": "@rhizogrip/spore-plugin-browser",
  "version": "0.2.0",
  "description": "A browser for spores: the agents' own Chrome, reached over CDP and driven by agent-browser",
  "author": {
    "name": "Christophe Le Bars",
    "email": "clb@toort.net"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RHIZOGRIP/spore.git",
    "directory": "plugins/browser"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "files": [
    "reference.md",
    "README.md",
    "NOTICE"
  ],
  "dependencies": {
    "agent-browser": "0.39.1"
  },
  "spore": {
    "works": "^1",
    "settings": {
      "cdp": "port"
    },
    "programs": {
      "SPORE_BROWSER": "agent-browser/bin/agent-browser-linux-x64"
    },
    "env": {
      "AGENT_BROWSER_CDP": "{settings.cdp}",
      "AGENT_BROWSER_SESSION": "{name}",
      "AGENT_BROWSER_PIN_TAB": "1",
      "AGENT_BROWSER_SOCKET_DIR": "{sockets}/browser",
      "AGENT_BROWSER_SCREENSHOT_DIR": "{data}/browser",
      "AGENT_BROWSER_DOWNLOAD_PATH": "{data}/browser/downloads"
    },
    "reference": "reference.md"
  },
  "release-it": {
    "git": {
      "requireBranch": "main",
      "commitMessage": "release: plugin-browser v${version}",
      "tagName": "plugin-browser-v${version}",
      "requireUpstream": false,
      "push": true
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": false
    }
  },
  "license": "Apache-2.0"
}
