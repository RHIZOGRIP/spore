{
  "name": "@rhizogrip/cairn",
  "version": "0.1.0",
  "description": "A shared, append-only, hash-chained record that agents, programs and people write to and read from",
  "author": {
    "name": "Christophe Le Bars",
    "email": "clb@toort.net"
  },
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RHIZOGRIP/spore.git",
    "directory": "packages/cairn"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "cairn": "bin/cairn.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "release-it": {
    "git": {
      "requireBranch": "main",
      "commitMessage": "release: cairn v${version}",
      "tagName": "package-cairn-v${version}",
      "requireUpstream": false,
      "push": true
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": false
    }
  }
}
